generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstname String?
  lastname  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id                String             @id @default(uuid())
  name              String
  hashedApiKey String @unique
  keyPreview String
  lastUsedAt DateTime?
  // apiKey was removed for security; raw key is only returned once upon creation
  userId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  logs              Log[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Log {
  id         String      @id @default(uuid())
  projectId  String
  message    String
  stackTrace String?
  level      LogLevel    @default(ERROR)
  url        String
  browser    String?
  os         String?
  resolved   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  aiAnalysis AiAnalysis?
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model AiAnalysis {
  id           String         @id @default(uuid())
  logId        String         @unique
  status       AnalysisStatus @default(PENDING)
  explanation  String?
  suggestedFix String?
  errorReason  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  log          Log            @relation(fields: [logId], references: [id], onDelete: Cascade)
}



enum LogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}
